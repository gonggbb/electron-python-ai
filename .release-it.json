{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "draft": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:bump": "echo 版本已更新为 ${version}"
  }
}
